# --- Veritabanı (MySQL 8) ---
DATABASE_URL=mysql+pymysql://kullanici:parola@sunucu:3306/dersper?charset=utf8mb4

# --- Güvenlik ---
# Oturum jetonlarını imzalar. Üretimde mutlaka değiştirin:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=degistir-beni
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Kaydedilen yapay zeka API anahtarını şifreler. Üretimde mutlaka değiştirin:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=degistir-beni

# --- Kayıt ---
# Herkese açık kurum kaydı. false yaparsanız yalnızca sistemde hiç kurum
# yokken (ilk kurulum) kayıt yapılabilir; sonrasında hesapları kurum içinden
# Kullanıcılar bölümünden açarsınız.
ALLOW_REGISTRATION=true

# --- CORS ---
# Boş bırakın. Arayüz hem geliştirmede (Vite proxy) hem üretimde (aynı konteyner)
# API ile aynı kökeni kullanır, bu yüzden CORS gerekmez. Yalnızca API'yi başka
# bir alan adındaki istemciden çağıracaksanız virgülle ayırarak doldurun.
CORS_ORIGINS=

# --- Docker ile dağıtım ---
# Yalnızca docker-compose.standalone.yml ile birlikte kullanılır: ters vekili
# olmayan sunucularda uygulamanın yayınlanacağı port. Dokploy/Coolify
# kullanıyorsanız gerekmez; alan adını panelden `app` servisinin 8000. portuna
# bağlarsınız.
WEB_PORT=8080
